# 复制本文件为根目录 .env 后再启动。生产环境请使用足够长的随机值。
SECRET_KEY=请替换为随机生成的长密钥

# PostgreSQL 配置。密码会用于连接串，请只使用字母、数字、下划线或连字符。
POSTGRES_DB=xiangqidao
POSTGRES_USER=xiangqidao
POSTGRES_PASSWORD=请替换为数据库强密码

# 网站对外监听端口
HTTP_PORT=8080
TZ=Asia/Shanghai

# 允许跨源调用 API 的前端来源（逗号分隔）。留空表示全放开（仅同源 Web 部署时影响小）。
# 打包 Android 客户端后必须包含 https://tauri.localhost，例如：
# CORS_ORIGINS=https://tauri.localhost,https://你的域名
CORS_ORIGINS=

# 可选：明确指定管理员用户名；留空时首位注册用户成为管理员。
ADMIN_USERNAME=

# 可选：AI 教练配置，也可以部署后在管理后台设置。
LLM_API_KEY=
LLM_PROTOCOL=openai_chat
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# 在线开局库：1 开启，0 关闭。
CLOUDBOOK_ENABLED=1
