{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xiangqidao",
  "version": "0.1.0",
  "identifier": "com.xiangqidao.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../frontend/dist-tauri"
  },
  "app": {
    "windows": [
      {
        "title": "象棋道",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine"
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
