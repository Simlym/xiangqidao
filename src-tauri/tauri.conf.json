{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "象棋道",
  "version": "0.1.0",
  "identifier": "com.xiangqidao.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix frontend run build:tauri",
    "frontendDist": "../frontend/dist-tauri"
  },
  "app": {
    "windows": [
      {
        "title": "象棋道",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
