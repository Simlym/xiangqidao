# 象棋道后端配置示例。
#
# 复制为 backend/.env 后按需取消注释即可,启动时自动加载(app/core/env.py),
# 无需额外操作。真实环境变量优先级高于本文件,线上部署仍可用环境变量覆盖。
# .env 含密钥等敏感信息,已在 .gitignore 中排除,请勿提交到仓库。

# ── 服务 ─────────────────────────────────────────────────────────
# 后端监听地址与端口
#HOST=127.0.0.1
#PORT=8000
# 开发热重载:1 开 / 0 关
#RELOAD=0
# 信任的前端代理 IP,逗号分隔
#FORWARDED_ALLOW_IPS=127.0.0.1

# ── 部署环境 ─────────────────────────────────────────────────────
# 设为 production 时:强制校验 SECRET_KEY 并关闭 /docs
#APP_ENV=production
# 登录 token 签名密钥;生产必须设置随机值,如 `openssl rand -hex 32`
#SECRET_KEY=
# 允许跨域的前端来源,逗号分隔;留空=全部放开(仅限本地开发)
#CORS_ORIGINS=http://localhost:5173,http://tauri.localhost
# 指定管理员用户名;留空则首位注册用户成为管理员
#ADMIN_USERNAME=
# 签到与连签判定的时区(POSIX 标准时区变量)
#TZ=Asia/Shanghai

# ── 数据库 ───────────────────────────────────────────────────────
# SQLAlchemy 连接串
#DATABASE_URL=sqlite:///./data/puzzles.db

# ── 引擎 ─────────────────────────────────────────────────────────
# 管理员自行放置的服务端 UCI 引擎绝对路径；管理后台保存的路径优先。
# 公共 SaaS 不建议执行用户上传的原生程序，优先让引擎在用户设备本地运行。
#XIANGQI_ENGINE=/absolute/path/to/xiangqi-engine
#JIEQI_ENGINE=/absolute/path/to/jieqi-engine

# ── 云库(在线开局库)───────────────────────────────────────────
# 设为 0 关闭
#CLOUDBOOK_ENABLED=1
# 查询接口地址
#CLOUDBOOK_URL=https://www.chessdb.cn/chessdb.php
# 单次查询超时秒数
#CLOUDBOOK_TIMEOUT=1.5
# 引擎走子参考云库的最大半着数(24 = 前 12 回合)
#CLOUDBOOK_MAX_PLY=24

# ── AI(LLM)────────────────────────────────────────────────────
# 注意:管理后台保存的设置优先于环境变量,这里仅作初始/兜底来源
#LLM_API_KEY=
# 接口格式:openai_chat / openai_responses / anthropic
#LLM_PROTOCOL=openai_chat
# LLM 服务地址
#LLM_BASE_URL=https://api.openai.com/v1
# 模型名称
#LLM_MODEL=gpt-4.1-mini
# 思考模式:1 开 / 0 关
#LLM_THINKING_ENABLED=1
# 思考强度:low / medium / high / xhigh / max
#LLM_REASONING_EFFORT=high
