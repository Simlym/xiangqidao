{
  "name": "xiangqidao-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:android": "vite --mode android",
    "build": "vite build",
    "build:tauri": "vite build --mode tauri --outDir dist-tauri",
    "build:android": "vite build --mode android --outDir dist-tauri",
    "test:core": "node --test src/core/**/*.test.js src/platform/**/*.test.js",
    "preview": "vite preview",
    "tauri": "cd .. && node frontend/node_modules/@tauri-apps/cli/tauri.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.1.0"
  }
}
